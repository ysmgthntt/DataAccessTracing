<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <add name="DefaultConnection"
         connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=DataAccessTracingTestDB;Integrated Security=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <system.data>
    <DbProviderFactories>
      <add name="DummyFactory" invariant="DummyFactory" description="DummyFactory"
           type="DummyFactory, ConsoleAppNet48" />
    </DbProviderFactories>
  </system.data>
</configuration>
