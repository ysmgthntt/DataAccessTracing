<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net45 : DbConnection.OpenAsync -->
    <!-- net7.0: ArgumentNullException.ThrowIfNull -->
    <TargetFrameworks>net7.0;netstandard2.1;net35;net45</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>14.0</LangVersion>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>DataAccessTracing</PackageId>
    <Version>1.0.0</Version>
    <Authors>ysmgthntt</Authors>
    <Copyright>© 2026 ysmgthntt</Copyright>
    <Description>A tracing library for monitoring ADO.NET database access, including SQL command execution and database object lifecycle.</Description>
    <PackageProjectUrl>https://github.com/ysmgthntt/DataAccessTracing</PackageProjectUrl>
    <RepositoryUrl>$(PackageProjectUrl)</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>ADO.NET;Database</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Net.Http" />
    <Using Condition="'$(TargetFramework)' == 'net35'" Remove="System.Threading.Tasks" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">
    <Reference Include="System.Transactions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Condition="'$(TargetFramework)' != 'net35'" Include="DataAccessTracing.Tests" />
    <InternalsVisibleTo Condition="'$(TargetFramework)' == 'net35'" Include="DataAccessTracing.Tests.Net35" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
